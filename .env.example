# Copiez ce fichier en .env.local (ignoré par git) et remplissez-le avec les
# valeurs de votre projet Supabase : Project Settings > API Keys.
# Ces deux valeurs sont publiques (elles finissent dans l'app) ; la sécurité
# repose sur les règles RLS de supabase/migrations. Sans elles : mode démo.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
